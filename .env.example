# Managed Postgres connection used by the app runtime (pooled URL recommended).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB_NAME?sslmode=require"

# Optional direct connection for Prisma migrations (non-pooled URL).
# If your provider only gives one URL, you can set DIRECT_URL equal to DATABASE_URL.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DB_NAME?sslmode=require"

# Application secrets
JWT_SECRET="replace-with-a-long-random-secret"

# Cloudinary
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Optional map creation tooling gate
ENABLE_MAP_CREATION_TOOLS="false"
